APP_NAME=zhicetong-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_HOST=192.168.216.101
POSTGRES_PORT=5432
POSTGRES_DB=zhicetong
POSTGRES_USER=zhicetong
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://zhicetong:change_me@192.168.216.101:5432/zhicetong

UPLOAD_DIR=storage/uploads
PARSED_DIR=storage/parsed
MAX_UPLOAD_FILE_SIZE_MB=20

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-embedding-v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

LLAMAINDEX_VECTOR_TABLE=llamaindex_policy_chunks
LLAMAINDEX_SCHEMA=public

LLM_PROVIDER=mock
LLM_MODEL=mock-policy-qa-v1
LLM_API_URL=
LLM_API_KEY=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=90
LLM_THINKING_TYPE=

